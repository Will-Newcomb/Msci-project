def cartan_unitary(angles, k_matrices):
    """Construct V = exp(-i sum_j theta_j B_j)."""
    G = np.zeros_like(k_matrices[0], dtype=complex)

    for theta, B in zip(angles, k_matrices):
        G += theta * B

    return expm(-1j * G)



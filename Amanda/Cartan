
import numpy as np
from scipy.linalg import expm
from scipy.optimize import least_squares
from qiskit.quantum_info import Pauli


def pauli_matrix(label):
    """Convert a Qiskit Pauli string into a complex matrix."""
    return np.asarray(Pauli(label).to_matrix(), dtype=complex)


def build_hamiltonian(terms, coefficients):
    """
    Build H = sum_j coefficients[j] * Pauli(terms[j]).
    """
    if len(terms) != len(coefficients):
        raise ValueError("Terms and coefficients must have equal length.")

    if not terms:
        raise ValueError("At least one Pauli term is required.")

    n = len(terms[0])
    H = np.zeros((2**n, 2**n), dtype=complex)

    for term, coeff in zip(terms, coefficients):
        if len(term) != n:
            raise ValueError("Inconsistent Pauli string lengths.")
        H += coeff * pauli_matrix(term)

    return H


def cartan_decomposition(dla):
    """
    Split a Pauli-string DLA into:
      m: even number of Y operators
      k: odd number of Y operators

    Returns (m_terms, k_terms).
    """
    labels = list(dla.keys()) if isinstance(dla, dict) else list(dla)

    m_terms = [p for p in labels if p.count("Y") % 2 == 0]
    k_terms = [p for p in labels if p.count("Y") % 2 == 1]

    return m_terms, k_terms


def initial_hamiltonian(coefficients, h_terms):
    """Construct K0 from coefficients in the Cartan subspace h."""
    return build_hamiltonian(h_terms, coefficients)


def cartan_unitary(angles, k_matrices):
    """
    V = exp(-i * sum_j angles[j] * B_j),
    where B_j are Hermitian generators from k.
    """
    dim = k_matrices[0].shape[0]
    generator = np.zeros((dim, dim), dtype=complex)

    for angle, B in zip(angles, k_matrices):
        generator += angle * B

    return expm(-1j * generator)


def find_initial_hamiltonian(
    KT,
    h_terms,
    k_terms,
    n_starts=10,
    max_nfev=2000,
    seed=42
):
    """
    Numerically solve KT = V K0 V^dagger.

    K0 is restricted to span(h_terms).
    V is generated by the odd-Y Cartan k subalgebra.

    Returns a dictionary containing K0, V,
    coefficients, angles, and residual error.
    """
    rng = np.random.default_rng(seed)

    h_matrices = [pauli_matrix(p) for p in h_terms]
    k_matrices = [pauli_matrix(p) for p in k_terms]

    n_h = len(h_matrices)
    n_k = len(k_matrices)
    dim = KT.shape[0]

    if KT.shape != (dim, dim) or dim != h_matrices[0].shape[0]:
        raise ValueError("Target and basis dimensions do not match.")

    if not np.allclose(KT, KT.conj().T):
        raise ValueError("KT must be Hermitian.")

    # The target must lie in m for this Cartan construction.
    # All Pauli matrices are orthogonal under the trace.
    m_projection = np.zeros_like(KT, dtype=complex)
    for p in h_terms + k_terms:
        if p.count("Y") % 2 == 0:
            P = pauli_matrix(p)
            m_projection += np.trace(P @ KT).real / dim * P

    projection_error = np.linalg.norm(KT - m_projection)
    if projection_error > 1e-8:
        raise ValueError(
            "KT is not entirely in the even-Y Cartan subspace m."
        )

    target_norm = max(np.linalg.norm(KT), 1e-12)

    def unpack(x):
        coeffs = x[:n_h]
        angles = x[n_h:]
        return coeffs, angles

    def residual(x):
        coeffs, angles = unpack(x)

        K0 = initial_hamiltonian(coeffs, h_terms)
        V = cartan_unitary(angles, k_matrices)

        K_final = V @ K0 @ V.conj().T
        difference = (K_final - KT) / target_norm

        return np.concatenate([
            difference.real.ravel(),
            difference.imag.ravel()
        ])

    # Starting estimate: project KT onto h.
    initial_coeffs = np.array([
        np.trace(P @ KT).real / dim for P in h_matrices
    ])

    best = None

    for run in range(n_starts):
        if run == 0:
            coeffs0 = initial_coeffs.copy()
            angles0 = np.zeros(n_k)
        else:
            coeffs0 = initial_coeffs + rng.normal(
                0, 0.5, size=n_h
            )
            angles0 = rng.normal(0, 0.5, size=n_k)

        x0 = np.concatenate([coeffs0, angles0])

        result = least_squares(
            residual,
            x0,
            max_nfev=max_nfev,
            ftol=1e-10,
            xtol=1e-10,
            gtol=1e-10
        )

        error = np.linalg.norm(result.fun)

        if best is None or error < best["error"]:
            coeffs, angles = unpack(result.x)
            K0 = initial_hamiltonian(coeffs, h_terms)
            V = cartan_unitary(angles, k_matrices)

            best = {
                "K0": K0,
                "V": V,
                "coefficients": coeffs,
                "angles": angles,
                "h_terms": h_terms,
                "error": error,
                "success": error < 1e-7
            }

        if best["success"]:
            break

    return best

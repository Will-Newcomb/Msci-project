
import numpy as np
from scipy.linalg import expm
from scipy.optimize import least_squares

from initial_hamiltonian import (
    pauli_matrix,
    initial_hamiltonian
)


def cartan_decomposition(lie_algebra):
    """Split DLA into even-Y (m) and odd-Y (k) terms."""
    labels = list(lie_algebra)

    m_terms = [
        p for p in labels if p.count("Y") % 2 == 0
    ]
    k_terms = [
        p for p in labels if p.count("Y") % 2 == 1
    ]

    return m_terms, k_terms


def cartan_unitary(angles, k_matrices):
    """Construct V = exp(-i sum_j theta_j B_j)."""
    G = np.zeros_like(k_matrices[0], dtype=complex)

    for theta, B in zip(angles, k_matrices):
        G += theta * B

    return expm(-1j * G)


def find_cartan_transformation(
    KT,
    h_terms,
    k_terms,
    n_starts=20,
    max_nfev=2000,
    seed=42
):
    """
    Find K0 and V such that KT approximately equals V K0 V†.
    """
    rng = np.random.default_rng(seed)

    h_matrices = [pauli_matrix(p) for p in h_terms]
    k_matrices = [pauli_matrix(p) for p in k_terms]

    if not h_matrices or not k_matrices:
        raise ValueError("Cartan bases cannot be empty.")

    if not np.allclose(KT, KT.conj().T):
        raise ValueError("KT must be Hermitian.")

    dim = KT.shape[0]
    if KT.shape != (dim, dim) or h_matrices[0].shape != KT.shape:
        raise ValueError("Incompatible matrix dimensions.")

    # Check that h is commuting.
    for A in h_matrices:
        for B in h_matrices:
            if not np.allclose(A @ B, B @ A):
                raise ValueError("h_terms must commute.")

    # Check target belongs to the even-Y subspace of the DLA.
    dla_labels = set(h_terms) | set(k_terms)
    # In practice, also supply the remaining even-Y DLA
    # labels when verifying the complete Cartan subspace.
    target_norm = max(np.linalg.norm(KT), 1e-12)

    n_h = len(h_matrices)
    n_k = len(k_matrices)

    def residual(x):
        coefficients = x[:n_h]
        angles = x[n_h:]

        K0 = initial_hamiltonian(coefficients, h_terms)
        V = cartan_unitary(angles, k_matrices)

        difference = (
            V @ K0 @ V.conj().T - KT
        ) / target_norm

        return np.concatenate([
            difference.real.ravel(),
            difference.imag.ravel()
        ])

    # Project KT onto h to obtain an initial estimate.
    coefficients_guess = np.array([
        np.trace(A @ KT).real / dim
        for A in h_matrices
    ])

    best_result = None
    best_error = np.inf

    for run in range(n_starts):
        if run == 0:
            coefficients = coefficients_guess
            angles = np.zeros(n_k)
        else:
            coefficients = coefficients_guess + rng.normal(
                0, 0.5, n_h
            )
            angles = rng.normal(0, 0.5, n_k)

        x0 = np.concatenate([coefficients, angles])

        result = least_squares(
            residual,
            x0,
            max_nfev=max_nfev
        )

        error = np.linalg.norm(result.fun)

        if error < best_error:
            best_error = error

            best_coefficients = result.x[:n_h]
            best_angles = result.x[n_h:]

            K0 = initial_hamiltonian(
                best_coefficients, h_terms
            )
            V = cartan_unitary(
                best_angles, k_matrices
            )

            best_result = {
                "K0": K0,
                "V": V,
                "coefficients": best_coefficients,
                "angles": best_angles,
                "error": error,
                "success": error < 1e-7
            }

        if best_error < 1e-7:
            break

    return best_result
